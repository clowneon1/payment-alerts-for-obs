<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface1"
    android:layout_marginBottom="10dp"
    android:padding="16dp">

    <!-- Row 1: time · app · TEST badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvLogTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11.5sp"
            android:textColor="@color/textDim"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvLogApp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accentLight"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- TEST badge -->
        <TextView
            android:id="@+id/tvTestBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" SIM "
            android:textSize="9.5sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="@color/warning"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 2: Exact Raw Title (if present) -->
    <TextView
        android:id="@+id/tvLogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/textMain"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <!-- Row 3: Exact Raw Notification Body / Big Text -->
    <TextView
        android:id="@+id/tvLogText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/textMuted"
        android:layout_marginBottom="6dp" />

    <!-- Row 4: Exact Subtext (if present) -->
    <TextView
        android:id="@+id/tvLogSubText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/textDim"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Row 5: Sender + Amount (Extracted Chips) -->
    <LinearLayout
        android:id="@+id/layoutChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLogSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/textMain"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvLogAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/success" />
    </LinearLayout>

    <!-- Row 6: Retrigger + Delete buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnRetrigger"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Retrigger"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent"
            android:layout_marginEnd="8dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnDeleteEntry"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textSize="13sp"
            android:textColor="@color/textMuted"
            android:backgroundTint="@color/surface2"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
