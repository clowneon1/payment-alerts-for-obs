<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface1"
    android:padding="24dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerInside"
            android:contentDescription="Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="StreamPe"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textMain" />

            <TextView
                android:id="@+id/tvAboutVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v2.2.0"
                android:textSize="12.5sp"
                android:textColor="@color/textDim" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAboutStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latest ✓"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:background="@color/surface2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Update Available Box -->
    <LinearLayout
        android:id="@+id/layoutAboutUpdateBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface2"
        android:padding="16dp"
        android:layout_marginBottom="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAboutNewVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New update available: v2.x.x"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accentLight"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnAboutDownloadUpdate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Download Update (APK)"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- Community & Support Links -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <Button
            android:id="@+id/btnAboutDiscord"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Discord Support"
            android:textSize="12sp"
            android:textColor="@color/accentLight"
            android:backgroundTint="@color/accentDim"
            android:layout_marginEnd="6dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnAboutGitHub"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="GitHub Star"
            android:textSize="12sp"
            android:textColor="#ffb703"
            android:backgroundTint="@color/surface2"
            android:layout_marginStart="6dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAboutReopenWizard"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Re-run Setup Wizard"
        android:textSize="12sp"
        android:textColor="@color/textMuted"
        android:backgroundTint="@color/surface2"
        android:layout_marginBottom="16dp"
        android:stateListAnimator="@null" />

    <TextView
        android:id="@+id/tvAboutMadeWithLove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Made with ❤️ by clowneon1"
        android:textSize="11.5sp"
        android:textColor="@color/textDim"
        android:gravity="center" />

</LinearLayout>
