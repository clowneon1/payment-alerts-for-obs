<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StreamPe" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">#0e0e10</item>
        <item name="android:navigationBarColor">#0e0e10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#9146FF</item>
        <item name="colorPrimaryVariant">#7a26e7</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#131315</item>
        <item name="colorOnSurface">#f4f4f5</item>
        <item name="android:textColorPrimary">#f4f4f5</item>
        <item name="android:textColorSecondary">#a1a1aa</item>
        <item name="android:windowBackground">#0e0e10</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
    </style>

    <style name="Theme.StreamPe.Splash" parent="Theme.StreamPe">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">#302f36</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">#302f36</item>
        <item name="hintTextColor">#a1a1aa</item>
    </style>
</resources>
